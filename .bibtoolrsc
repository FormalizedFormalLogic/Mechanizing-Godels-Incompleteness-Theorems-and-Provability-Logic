# This is a config file for bibtool, see http://www.gerd-neugebauer.de/software/TeX/BibTool/en/
# Borrow from https://github.com/oscar-system/Oscar.jl/blob/master/.bibtoolrsc

sort = on
sort.order{* =
    bibkey
    author
    title
    editor
    booktitle
    mrnumber
    zbl
    journal
    fjournal
    series
    volume
    number
    note
    howpublished
    type
    address
    organization
    publisher
    edition
    pages
    year
    month
    doi
    url
}
sort.cased = off

delete.field = { keywords }
delete.field = { abstract }
delete.field = { file }

# Fields that Zotero (and Zbl/JFM imports) emit but neither BibTeX nor Typst
# reads.  `urlyear` in particular is not a field at all -- the access date is
# `urldate` -- so keeping it only makes entries look as if they recorded one.
delete.field = { annotation }
delete.field = { copyright }
delete.field = { day }
delete.field = { fjournal }
delete.field = { fseries }
delete.field = { jfm }
delete.field = { lccn }
delete.field = { numpages }
delete.field = { shortjournal }
delete.field = { shorttitle }
delete.field = { urlyear }
delete.field = { zbl }
delete.field = { zbmath }
delete.field = { zmnumber }

# Typst (hayagriva) does not map BibTeX's `school`/`institution` onto the CSL
# `publisher` variable, so the awarding university of a thesis and the issuing
# body of a report silently disappear from the bibliography -- even though the
# ACM style (and CSL in general) reads them from `publisher`.
# See https://github.com/typst/hayagriva/issues/112 and .../issues/86.
# Both fields are only meaningful for @*thesis / @techreport entries, whose CSL
# counterpart is `publisher` anyway, so the rename is unconditional.
rename.field { school = publisher }
rename.field { institution = publisher }

# biblatex spellings that Zotero exports but BibTeX-based readers ignore:
# a `journaltitle` silently drops the journal name from the bibliography.
rename.field { journaltitle = journal }
rename.field { location = address }
rename.field { language = langid }
rename.field { eprinttype = archiveprefix }
rename.field { eprintclass = primaryclass }

print.align.key = 0
print.line.length = 120
print.use.tab = off

preserve.key.case = on

# Unify key format
key.base = upper
key.number.separator = {}
fmt.name.name = {}
# von part (e.g. "de" in "de Jongh") lower-case, last name initial upper-case: "de Jongh" -> "dJ"
# Used for multi-author keys via %8.2p below (e.g. "de Jongh" + "Yang" -> "dJY").
#
# NOTE: BibTool's key.format language cannot express "if this single author's
# name has a von part, use format 2; otherwise use the plain 3-letter
# abbreviation" as a single declarative rule (the von/last/first/junior
# sub-letters are only available inside new.format.type strings, and %p/%n
# never *fail* just because a name part is empty, so there is no way to branch
# on "von part is absent" for the single-author case at the top level).
# So single-author entries default to the plain 3-letter last-name
# abbreviation here, and entries whose sole author's surname has a von part
# (e.g. "van Benthem" -> "vB", "de Jongh" -> "dJ") must set an explicit
# `bibkey = {...}` field to override it (checked first, via %s(bibkey) below).
#
# The same applies to multi-word surnames. %1.3n truncates *each word* of the
# surname to 3 characters and joins them with a hyphen that BibTool hard-codes
# (fmt.inter.name does not apply to key generation), so "Sierra Miranda"
# becomes "Sie-Mir" rather than "SM". Shortening to %1.1n would only turn that
# into "S-M" while collapsing every ordinary surname to a single letter, so
# such entries also need an explicit `bibkey` (e.g. SM23a).
new.format.type {2 = "%-1v%+1l"}
key.format =
{
  %s(bibkey)
 #
    %.1#n(author)
    { %1.3n(author) }
    { %2d(year) }
 #
    { %8.2p(author) }
    { %2d(year) }
}

# Remove empty fields
rewrite.rule { "^{ *}$" }

# Normalize the month field to e.g. `jan` (without braces), see https://github.com/ge-ne/bibtool/issues/66#issuecomment-577283871
rewrite.case.sensitive = Off
rewrite.rule { month "{\([^#]*\)}" "\1"}
rewrite.rule { month "^ *\(1\|Jan.*\|jan.+\) *$" "jan" }
rewrite.rule { month "^ *\(2\|Feb.*\|feb.+\) *$" "feb" }
rewrite.rule { month "^ *\(3\|Mar.*\|mar.+\) *$" "mar" }
rewrite.rule { month "^ *\(4\|Apr.*\|apr.+\) *$" "apr" }
rewrite.rule { month "^ *\(5\|May.*\|may.+\) *$" "may" }
rewrite.rule { month "^ *\(6\|Jun.*\|jun.+\) *$" "jun" }
rewrite.rule { month "^ *\(7\|Jul.*\|jul.+\) *$" "jul" }
rewrite.rule { month "^ *\(8\|Aug.*\|aug.+\) *$" "aug" }
rewrite.rule { month "^ *\(9\|Sep.*\|sep.+\) *$" "sep" }
rewrite.rule { month "^ *\(10\|Oct.*\|oct.+\) *$" "oct" }
rewrite.rule { month "^ *\(11\|Nov.*\|nov.+\) *$" "nov" }
rewrite.rule { month "^ *\(12\|Dec.*\|dec.+\) *$" "dec" }
