@article{Lyon2025,
  title     = {Unifying {{Sequent Systems}} for {{G\"odel-L\"ob Provability Logic}} via {{Syntactic Transformations}}},
  author    = {Lyon, Tim S.},
  editor    = {Endrullis, J{\"o}rg and Schmitz, Sylvain},
  year      = 2025,
  journal   = {LIPIcs, Volume 326, CSL 2025},
  volume    = {326},
  pages     = {42:1-42:23},
  publisher = {Schloss Dagstuhl -- Leibniz-Zentrum f\"ur Informatik},
  issn      = {1868-8969},
  doi       = {10.4230/LIPICS.CSL.2025.42},
  urldate   = {2026-07-06},
  abstract  = {We demonstrate the inter-translatability of proofs between the most prominent sequent-based formalisms for G\"odel-L\"ob provability logic. In particular, we consider Sambin and Valentini's sequent system GL\_\textbraceleft seq\textbraceright, Shamkanov's non-wellfounded and cyclic sequent systems GL\_{$\infty$} and GL\_\textbraceleft circ\textbraceright, Poggiolesi's tree-hypersequent system CSGL, and Negri's labeled sequent system G3GL. Shamkanov provided proof-theoretic correspondences between GL\_\textbraceleft seq\textbraceright, GL\_{$\infty$}, and GL\_\textbraceleft circ\textbraceright, and Gor\'e and Ramanayake showed how to transform proofs between CSGL and G3GL, however, the exact nature of proof transformations between the former three systems and the latter two systems has remained an open problem. We solve this open problem by showing how to restructure tree-hypersequent proofs into an end-active form and introduce a novel linearization technique that transforms such proofs into linear nested sequent proofs. As a result, we obtain a new proof-theoretic tool for extracting linear nested sequent systems from tree-hypersequent systems, which yields the first cut-free linear nested sequent calculus LNGL for G\"odel-L\"ob provability logic. We show how to transform proofs in LNGL into a certain normal form, where proofs repeat in stages of modal and local rule applications, and which are translatable into GL\_\textbraceleft seq\textbraceright{} and G3GL proofs. These new syntactic transformations, together with those mentioned above, establish full proof-theoretic correspondences between GL\_\textbraceleft seq\textbraceright, GL\_{$\infty$}, GL\_\textbraceleft circ\textbraceright, CSGL, G3GL, and LNGL while also giving (to the best of the author's knowledge) the first constructive proof mappings between structural (viz. labeled, tree-hypersequent, and linear nested sequent) systems and a cyclic sequent system.},
  copyright = {Creative Commons Attribution 4.0 International license, info:eu-repo/semantics/openAccess},
  isbn      = {9783959773621},
  langid    = {english},
  keywords  = {Cyclic proof,Godel-Lob logic,Labeled sequent,Linear nested sequent,Modal logic,Non-wellfounded proof,Proof theory,Proof transformation,Theory of computation  Constructive mathematics,Theory of computation  Modal and temporal logics,Theory of computation  Proof theory,Tree-hypersequent},
  file      = {C:\Users\sno2wman\Zotero\storage\6NIFXLKJ\Lyon - 2025 - Unifying Sequent Systems for Gödel-Löb Provability Logic via Syntactic Transformations.pdf}
}
@article{Poggiolesi2009,
  title     = {A Purely Syntactic and Cut-Free Sequent Calculus for the Modal Logic of Provability},
  author    = {Poggiolesi, Francesca},
  year      = 2009,
  month     = dec,
  journal   = {The Review of Symbolic Logic},
  volume    = {2},
  number    = {4},
  pages     = {593--611},
  issn      = {1755-0203, 1755-0211},
  doi       = {10.1017/S1755020309990244},
  urldate   = {2026-07-26},
  abstract  = {In this paper we present a sequent calculus for the modal propositional logic GL (the logic of provability) obtained by means of the tree-hypersequent method, a method in which the metalinguistic strength of hypersequents is improved, so that we can simulate trees shapes. We prove that this sequent calculus is sound and complete with respect to the Hilbert-style system GL, that it is contraction free and cut free and that its logical and modal rules are invertible. No explicit semantic element is used in the sequent calculus and all the results are proved in a purely syntactic way.},
  copyright = {https://www.cambridge.org/core/terms},
  langid    = {english}
}
