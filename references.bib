@mastersthesis{Bilotta2025,
  title         = {Growing a {{Modular Framework}} for {{Modal Systems- HOLMS}}: A {{HOL Light Library}}},
  shorttitle    = {Growing a {{Modular Framework}} for {{Modal Systems- HOLMS}}},
  author        = {Bilotta, Antonella},
  year          = 2025,
